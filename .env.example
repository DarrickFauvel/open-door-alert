# Copy to .env and edit. All values are optional.

# mock = simulated door (any computer), gpio = real reed switch + LED on the Pi
MODE=mock
PORT=3000

# BCM pin numbers
DOOR_PIN=17
LED_PIN=27
GPIO_CHIP=gpiochip0
DEBOUNCE_MS=50
# Which GPIO level means "door open": high (default, NC reed to GND) or low
DOOR_OPEN_LEVEL=high

# Send the phone alert after the door has been open this long, then remind every N seconds
ALERT_DELAY_S=30
REMIND_EVERY_S=300

# ntfy: install the ntfy app and subscribe to the same topic.
# Use a long random topic name, e.g. `openssl rand -hex 12`. Topics on ntfy.sh are public!
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Optional access token (self-hosted ntfy or ntfy Pro reserved topics)
NTFY_TOKEN=

DOOR_NAME=Front door

# Weather outside the open door on the dashboard (Open-Meteo, free, no key).
# Your house's coordinates, e.g. from Google Maps (right-click > coordinates).
WEATHER_LAT=
WEATHER_LON=
# fahrenheit or celsius
WEATHER_UNITS=fahrenheit
WEATHER_REFRESH_MIN=10
